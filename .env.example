# =============================================================================
# Cerca API — environment contract.
# Every variable here MUST also exist in apps/api/src/config/env.ts (the Zod schema).
# Commit this file with EMPTY secret values; never commit .env.
# =============================================================================

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
# Puerto dedicado del backend (distinto del 3000 que suele usar el frontend).
PORT=3333
LOG_LEVEL=debug
REQUEST_TIMEOUT_MS=15000

# ── Database (matches docker-compose defaults) ───────────────────────────────
# Pooled connection used by the running app.
DATABASE_URL=postgresql://cerca:cerca@localhost:5432/cerca?schema=public
# Direct, non-pooled connection for `prisma migrate deploy` (DDL needs a real session).
DIRECT_DATABASE_URL=postgresql://cerca:cerca@localhost:5432/cerca?schema=public
# Optional shadow DB for `prisma migrate dev` and the drift check in verify.sh.
SHADOW_DATABASE_URL=postgresql://cerca:cerca@localhost:5432/cerca_shadow?schema=public
LOG_SLOW_QUERIES_MS=300

# ── Redis (cache · idempotency keys · refresh-token reuse guard) ─────────────
REDIS_URL=redis://localhost:6379

# ── Auth (@nestjs/jwt + refresh rotation) ────────────────────────────────────
# generate: openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── HTTP ─────────────────────────────────────────────────────────────────────
# Comma-separated allow-list. CORS is restricted to these origins.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
PUBLIC_API_URL=http://localhost:3333

# ── Behaviour tuning ─────────────────────────────────────────────────────────
IDEMPOTENCY_TTL_SECONDS=86400
CATEGORIES_CACHE_TTL_SECONDS=300
SEARCH_MAX_LIMIT=50
