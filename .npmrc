# Hoisted linker: shared dev tooling lives at the workspace root and is visible to every
# package (contract + api). Simplifies resolution of @cerca/contract and the Prisma client.
node-linker=hoisted

# typescript-eslint intentionally caps TypeScript at <6.1.0 while we pin 6.0.3, and a few
# Nest peers are looser than reality. Peer noise must not block installs; the real
# compatibility contract is enforced by scripts/check-versions.sh + verify.sh.
auto-install-peers=true
strict-peer-dependencies=false
