{
  "name": "cerca",
  "version": "0.1.0",
  "private": true,
  "description": "Cerca — marketplace de servicios locales · backend (NestJS + Prisma + PostGIS)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "check-types": "pnpm -r check-types",
    "setup": "bash scripts/setup.sh",
    "dev": "pnpm --filter @cerca/contract build && pnpm --filter @cerca/api start:dev",
    "contract:build": "pnpm --filter @cerca/contract build",
    "api": "pnpm --filter @cerca/api",
    "db:migrate": "pnpm --filter @cerca/api prisma migrate deploy",
    "db:seed": "pnpm --filter @cerca/api prisma db seed",
    "db:reset": "pnpm --filter @cerca/api prisma migrate reset --force",
    "reset": "bash scripts/reset.sh",
    "verify": "bash scripts/verify.sh --full",
    "check-versions": "bash scripts/check-versions.sh",
    "prepare": "husky && pnpm --filter @cerca/contract build"
  },
  "devDependencies": {
    "@swc/core": "1.15.47",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "prettier": "3.9.6",
    "tsx": "4.23.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "unplugin-swc": "1.5.10",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.10"
  },
  "pnpm": {
    "overrides": {
      "nanoid": ">=3.3.18",
      "@nestjs/swagger>js-yaml": ">=5.2.2"
    }
  }
}
